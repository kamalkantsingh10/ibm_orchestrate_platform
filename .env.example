# ──────────────────────────────────────────────────────────────────────────────
# Local development environment template.
# Copy to .env (`make bootstrap` does this automatically). .env is gitignored —
# real values MUST NEVER be committed.
#
# Story 1.5 (2026-04-29) re-scoped the dev stack to SQLite + local filesystem.
# Postgres / Redis / LocalStack / Vault are no longer used; the corresponding
# env vars were removed. Original defaults preserved in git history.
# ──────────────────────────────────────────────────────────────────────────────

# SQLite database file. Relative path → lives next to the repo at ./data/.
# data/ is gitignored so the .db file is per-developer mutable state.
DATABASE_URL=sqlite+aiosqlite:///./data/cockpit.db

# Demo identifiers written by `make seed`. Pinned so re-running is a no-op.
DEMO_TENANT_ID=00000000-0000-4000-8000-000000000001
DEMO_OFFICER_ID=00000000-0000-4000-8000-000000000002

# Story 1.4 — three demo users for the user-switcher dropdown.
# Mirror of contracts.users.{ANALYST_ID,TEAM_LEAD_ID,REGULATOR_ID}.
# Override is optional; the contract is the source of truth.
DEMO_ANALYST_ID=dc2aaaa3-555b-4636-89d0-6047dc205220
DEMO_TEAM_LEAD_ID=a725a9bb-5b8e-4984-8d23-19c682225002
DEMO_REGULATOR_ID=a1582a20-62e1-497b-910c-45c0b0ee7030

# ─── Story 3.1 ledger ───
# Append-only JSONL audit log path. Wiped by `make demo-reset`.
LEDGER_PATH=./data/ledger.jsonl

# ─── Story 3.4 Document Intelligence ───
# Provider for the doc-AI LLM call. "fixture" is offline; "watsonx" calls watsonx LLM.
DOC_AI_PROVIDER=fixture

# ─── ADK runtime + watsonx.ai credentials ───
# Required for `make adk-up` (the Developer Edition reads this as its LLM
# key) AND for `DOC_AI_PROVIDER=watsonx`. Get one from IBM Cloud → IAM →
# API keys. Free tier works. NEVER commit a real value — `.env` is
# gitignored; `.env.example` is the template.
#
# Variable name matches the ADK's own default.env convention (no
# underscore between API and KEY).
WATSONX_APIKEY=
# Optional: watsonx.ai space ID (some agents need it explicitly).
WATSONX_SPACE_ID=
# Optional: pin a specific model. Defaults to granite-3-2-8b-instruct.
WATSONX_MODEL_ID=watsonx/ibm/granite-3-2-8b-instruct
# Optional: the project_id used by the watsonx text-generation HTTP API
# (only needed if you call WatsonxDocAILLM directly, not via the chat UI).
WATSONX_PROJECT_ID=

# ─── Story 2.4 demo case fixtures (DOCUMENTATION ONLY — not read by code) ───
# packages/contracts/src/contracts/cases.py is the authoritative source for
# these IDs (SHREE_VENKAT_ID, VORA_CAPITAL_ID, ANANYA_IYER_ID). The env vars
# below are aids for operators who want to curl the API directly against a
# specific case ID. If env and contract disagree, the contract wins.
DEMO_CASE_SHREE_VENKAT_ID=case_01KQC7EWM0GYHP15CZ8JB5ZT69
DEMO_CASE_VORA_CAPITAL_ID=case_01KQC7GQ70GYHP15CZ8JB5ZT6A
DEMO_CASE_ANANYA_IYER_ID=case_01KQC7JHT0GYHP15CZ8JB5ZT6B
