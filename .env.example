# ──────────────────────────────────────────────────────────────────────────────
# Local development environment template (Story 1.2).
# Copy to .env (`make bootstrap` does this automatically) and fill any blanks
# marked CHANGE_ME. .env is gitignored — real values MUST NEVER be committed.
#
# The defaults below match `docker-compose.yml` so a fresh clone runs
# end-to-end without further edits, except for OIDC, which is wired in
# Story 1.6.
# ──────────────────────────────────────────────────────────────────────────────

# Postgres connection used by cockpit-api and Alembic.
DATABASE_URL=postgresql+asyncpg://cockpit:cockpit@localhost:5432/cockpit
# Sync URL used by Alembic offline migrations / scripts that need psycopg.
DATABASE_URL_SYNC=postgresql://cockpit:cockpit@localhost:5432/cockpit

# Redis — SSE coordination, undo timer, rate limit (Stories 4.6/4.7/2.10).
REDIS_URL=redis://localhost:6379/0

# Symmetric secret used to sign cookie sessions (≥32 random bytes, base64).
# Story 1.6 wires session signing; this dev placeholder is fine to commit
# because .env is gitignored.
SESSION_SECRET=dev-session-secret-change-me-32bytes!!

# OIDC issuer base URL. Story 1.6 owns OIDC; leave blank in this story.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=CHANGE_ME

# Object-store endpoint URL (S3-compatible). Points at LocalStack S3.
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=cockpit-dev
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# Vault Transit (HSM emulator) for KeyVault adapter dev impl (Story 3.2).
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token

# Demo identifiers written by `make seed`. Pinned so re-running is a no-op.
DEMO_TENANT_ID=00000000-0000-4000-8000-000000000001
DEMO_OFFICER_ID=00000000-0000-4000-8000-000000000002

# Story 1.4 — three demo users for the user-switcher dropdown.
# Mirror of contracts.users.{ANALYST_ID,TEAM_LEAD_ID,REGULATOR_ID}.
# Override is optional; the contract is the source of truth.
DEMO_ANALYST_ID=dc2aaaa3-555b-4636-89d0-6047dc205220
DEMO_TEAM_LEAD_ID=a725a9bb-5b8e-4984-8d23-19c682225002
DEMO_REGULATOR_ID=a1582a20-62e1-497b-910c-45c0b0ee7030
